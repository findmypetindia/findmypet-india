{
  "headers": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "findmypetindia.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.findmypetindia.com"
        }
      ],
      "destination": "https://findmypetindia.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "findmypet-india.vercel.app"
        }
      ],
      "destination": "https://findmypetindia.com/:path*",
      "statusCode": 301
    }
  ]
}
